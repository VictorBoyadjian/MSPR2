# Laravel auth service
LARAVEL_HOST=http://laravel-app
LARAVEL_PORT=8000
LARAVEL_ME_URL=/api/me

# Firebase — utiliser la version base64 en production (jamais commiter le fichier JSON)
# Pour générer : base64 -w 0 mlmspr2-firebase-adminsdk-xxx.json
FIREBASE_CREDENTIALS_B64=

# PostgreSQL (recommendation engine)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# CORS — liste d'origines autorisées séparées par des virgules
# Laisser vide autorise tout (développement uniquement)
ALLOWED_ORIGINS=https://mon-app.com,https://app.mondomaine.fr
